  <version>0.0.1</version>
  <description>Navigation (Nav2) and SLAM (slam_toolbox) configuration and launch files for AHSER</description>
  <maintainer email="kushal@todo.todo">kushal</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
