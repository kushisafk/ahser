<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ==================================================================== -->
  <!-- AHSER Perception & Localization Sensor Suite                        -->
  <!-- Frames and primitive visual/collision models for LiDAR, Camera, IMU  -->
  <!-- ==================================================================== -->

  <xacro:macro name="sensors">
    <!-- Top-Mounted 2D Planar LiDAR -->
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <!-- Elevated on the roof of the upper storage compartment for 360-deg FOV -->
      <origin xyz="${lidar_x_offset} 0.0 ${lidar_z_offset}" rpy="0 0 0"/>
    </joint>

    <link name="lidar_link">
      <!-- LiDAR Base Collar -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>

      <!-- LiDAR Rotating Optical Head Accent -->
      <visual>
        <origin xyz="0 0 ${lidar_height * 0.25}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius * 0.9}" length="${lidar_height * 0.4}"/>
        </geometry>
        <material name="medical_teal"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${lidar_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(lidar_mass / 12.0) * (3.0 * lidar_radius * lidar_radius + lidar_height * lidar_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${(lidar_mass / 12.0) * (3.0 * lidar_radius * lidar_radius + lidar_height * lidar_height)}"
          iyz="0.0"
          izz="${(lidar_mass / 2.0) * (lidar_radius * lidar_radius)}"/>
      </inertial>
    </link>

    <!-- Gazebo Sensor: 2D Planar LiDAR -->
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_link</gz_frame_id>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>

    <!-- Front-Facing RGB Perception Camera -->
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <!-- Mounted on the upper-front brow of the chassis facing forward (+X) -->
      <origin xyz="${camera_x_offset} 0.0 ${camera_z_offset}" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
      <!-- Camera Body Enclosure -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_length} ${camera_width} ${camera_height}"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>

      <!-- Camera Lens Barrel -->
      <visual>
        <origin xyz="${camera_length / 2.0 + 0.003} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="${camera_height * 0.3}" length="0.006"/>
        </geometry>
        <material name="lens_glass"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_length} ${camera_width} ${camera_height}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${camera_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(camera_mass / 12.0) * (camera_width * camera_width + camera_height * camera_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${(camera_mass / 12.0) * (camera_length * camera_length + camera_height * camera_height)}"
          iyz="0.0"
          izz="${(camera_mass / 12.0) * (camera_length * camera_length + camera_width * camera_width)}"/>
      </inertial>
    </link>

    <!-- Standard ROS Camera Optical Frame (Z forward, X right, Y down) -->
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_link"/>
      <origin xyz="0 0 0" rpy="-${pi/2} 0 -${pi/2}"/>
    </joint>

    <link name="camera_optical_link"/>

    <!-- Gazebo Sensor: Front RGB-D Perception Camera -->
    <gazebo reference="camera_link">
      <sensor name="camera" type="rgbd_camera">
        <gz_frame_id>camera_optical_link</gz_frame_id>
        <topic>/camera</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.085</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </depth_camera>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>

    <!-- Inertial Measurement Unit (IMU) -->
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <!-- Positioned close to the geometric center and drive axle -->
      <origin xyz="${imu_x_offset} 0.0 ${imu_z_offset}" rpy="0 0 0"/>
    </joint>

    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${imu_size} ${imu_size} ${imu_height}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${imu_size} ${imu_size} ${imu_height}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${imu_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(imu_mass / 12.0) * (imu_size * imu_size + imu_height * imu_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${(imu_mass / 12.0) * (imu_size * imu_size + imu_height * imu_height)}"
          iyz="0.0"
          izz="${(imu_mass / 12.0) * (imu_size * imu_size + imu_size * imu_size)}"/>
      </inertial>
    </link>

    <!-- Gazebo Sensor: Inertial Measurement Unit (IMU) -->
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <topic>/imu</topic>
        <update_rate>50</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- ==================================================================== -->
    <!-- Macro: Short-Range Ultrasonic Proximity Sonar Sensor                 -->
    <!-- ==================================================================== -->
    <xacro:macro name="ultrasonic_sensor" params="name x y z yaw">
      <joint name="ultrasonic_${name}_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_${name}_link"/>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
      </joint>

      <link name="ultrasonic_${name}_link">
        <visual>
          <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
          <geometry>
            <cylinder radius="0.010" length="0.008"/>
          </geometry>
          <material name="dark_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
          <geometry>
            <cylinder radius="0.010" length="0.008"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="0.015"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.000001" iyz="0.0"
            izz="0.000001"/>
        </inertial>
      </link>

      <gazebo reference="ultrasonic_${name}_link">
        <sensor name="ultrasonic_${name}" type="gpu_lidar">
          <gz_frame_id>ultrasonic_${name}_link</gz_frame_id>
          <topic>/ultrasonic/${name}</topic>
          <update_rate>15</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>5</samples>
                <resolution>1</resolution>
                <min_angle>-0.2618</min_angle>
                <max_angle>0.2618</max_angle>
              </horizontal>
              <vertical>
                <samples>3</samples>
                <resolution>1</resolution>
                <min_angle>-0.1309</min_angle>
                <max_angle>0.1309</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.04</min>
              <max>2.50</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </ray>
          <always_on>1</always_on>
          <visualize>false</visualize>
        </sensor>
      </gazebo>
    </xacro:macro>

    <!-- Ultrasonic Proximity Sensors: Front, Left, and Right Perimeter -->
    <xacro:ultrasonic_sensor name="front"
      x="${chassis_length / 2.0 + 0.005}" y="0.0" z="${ground_clearance + 0.050}" yaw="0.0"/>
    <xacro:ultrasonic_sensor name="left"
      x="0.140" y="${chassis_width / 2.0 + 0.005}" z="${ground_clearance + 0.050}" yaw="${pi/2}"/>
    <xacro:ultrasonic_sensor name="right"
      x="0.140" y="-${chassis_width / 2.0 + 0.005}" z="${ground_clearance + 0.050}" yaw="-${pi/2}"/>
  </xacro:macro>
</robot>
