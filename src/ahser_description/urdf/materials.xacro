<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ==================================================================== -->
  <!-- AHSER Material & Color Definitions                                  -->
  <!-- Clean, professional medical/service robot color palette             -->
  <!-- ==================================================================== -->

  <!-- Primary Chassis & Storage Body: Clean Hospital White -->
  <material name="hospital_white">
    <color rgba="0.92 0.94 0.96 1.0"/>
  </material>

  <!-- Accent: Medical Service Teal/Cyan for Doors & Brand Identification -->
  <material name="medical_teal">
    <color rgba="0.0 0.60 0.65 1.0"/>
  </material>

  <!-- Chassis Lower Skirt & Mechanical Mounts: Dark Graphite Grey -->
  <material name="dark_grey">
    <color rgba="0.22 0.22 0.25 1.0"/>
  </material>

  <!-- Secondary Trims & Structural Plates: Neutral Light Grey -->
  <material name="light_grey">
    <color rgba="0.75 0.77 0.80 1.0"/>
  </material>

  <!-- Drive Wheel Non-Marking Medical Rubber Tire (slate grey base) -->
  <material name="tire_rubber">
    <color rgba="0.28 0.30 0.33 1.0"/>
  </material>

  <!-- Non-marking tire high-traction grip tread lugs -->
  <material name="tire_tread">
    <color rgba="0.12 0.13 0.15 1.0"/>
  </material>

  <!-- Wheel rim alloy / hub face -->
  <material name="wheel_hub">
    <color rgba="0.80 0.83 0.86 1.0"/>
  </material>

  <!-- Drive Wheel Tires: Durable Matte Rubber Black -->
  <material name="wheel_black">
    <color rgba="0.12 0.12 0.12 1.0"/>
  </material>

  <!-- Passive Caster Spheres: Smooth Low-Friction Metallic Steel -->
  <material name="caster_metallic">
    <color rgba="0.65 0.65 0.68 1.0"/>
  </material>

  <!-- Sensor Enclosures (LiDAR, Camera body): Matte Black -->
  <material name="sensor_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <!-- Optical Lenses & Display Panel: Tinted Obsidian -->
  <material name="lens_glass">
    <color rgba="0.05 0.05 0.08 1.0"/>
  </material>
</robot>
