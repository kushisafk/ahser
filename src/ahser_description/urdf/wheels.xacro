<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ==================================================================== -->
  <!-- AHSER Wheels & Mobile Base Locomotion Module                        -->
  <!-- High-traction non-marking hospital floor tires & passive casters     -->
  <!-- ==================================================================== -->

  <!-- Macro: Realistic low-profile tire tread grip lug along wheel circumference -->
  <xacro:macro name="tread_lug" params="angle">
    <visual>
      <origin
        xyz="${(wheel_radius - 0.0005) * cos(angle)} 0 ${(wheel_radius - 0.0005) * sin(angle)}"
        rpy="0 ${-angle} 0"/>
      <geometry>
        <!-- Sleek, subtle 0.5mm tread grip flush with tire surface (not spiked) -->
        <box size="0.002 ${wheel_width + 0.001} 0.012"/>
      </geometry>
      <material name="tire_tread"/>
    </visual>
  </xacro:macro>

  <!-- Macro: Differential Drive Powered Wheel -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- Symmetrical placement along the transverse (Y) axle -->
      <origin xyz="0.0 ${y_reflect * (wheel_track / 2.0)} ${wheel_radius}" rpy="0 0 0"/>
      <!-- Standard ROS differential drive rotation axis (Pitch / Y-axis) -->
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <!-- Main non-marking hospital grade rubber tire -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="tire_rubber"/>
      </visual>

      <!-- Inner recessed wheel rim bed -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.65}" length="${wheel_width + 0.002}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <!-- 8-segment high-traction grip tread pattern around perimeter (visible from top view) -->
      <xacro:tread_lug angle="0"/>
      <xacro:tread_lug angle="${pi/4}"/>
      <xacro:tread_lug angle="${pi/2}"/>
      <xacro:tread_lug angle="${3*pi/4}"/>
      <xacro:tread_lug angle="${pi}"/>
      <xacro:tread_lug angle="${-3*pi/4}"/>
      <xacro:tread_lug angle="${-pi/2}"/>
      <xacro:tread_lug angle="${-pi/4}"/>

      <!-- Outer Wheel Rim & Hub Face (offset toward exterior) -->
      <!-- Center hub cap -->
      <visual>
        <origin xyz="0 ${y_reflect * (wheel_width / 2.0 + 0.003)} 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.25}" length="0.004"/>
        </geometry>
        <material name="wheel_hub"/>
      </visual>

      <!-- High-contrast alloy rim spokes for side-view rotational visibility -->
      <visual>
        <origin xyz="0 ${y_reflect * (wheel_width / 2.0 + 0.002)} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${wheel_radius * 1.15} 0.002 0.014"/>
        </geometry>
        <material name="wheel_hub"/>
      </visual>

      <visual>
        <origin xyz="0 ${y_reflect * (wheel_width / 2.0 + 0.002)} 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.014 0.002 ${wheel_radius * 1.15}"/>
        </geometry>
        <material name="wheel_hub"/>
      </visual>

      <visual>
        <origin xyz="0 ${y_reflect * (wheel_width / 2.0 + 0.002)} 0" rpy="0 ${pi/4} 0"/>
        <geometry>
          <box size="${wheel_radius * 1.15} 0.002 0.012"/>
        </geometry>
        <material name="medical_teal"/>
      </visual>

      <visual>
        <origin xyz="0 ${y_reflect * (wheel_width / 2.0 + 0.002)} 0" rpy="0 ${-pi/4} 0"/>
        <geometry>
          <box size="${wheel_radius * 1.15} 0.002 0.012"/>
        </geometry>
        <material name="medical_teal"/>
      </visual>

      <!-- Physical collision cylinder (clean smooth cylindrical contact for simulation) -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- Accurate cylinder inertia aligned with rotation axis Y -->
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(wheel_mass / 12.0) * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${(wheel_mass / 2.0) * (wheel_radius * wheel_radius)}"
          iyz="0.0"
          izz="${(wheel_mass / 12.0) * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Macro: Passive Support Caster Wheel -->
  <xacro:macro name="caster_wheel" params="prefix x_offset">
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <!-- Positioned along sagittal centerline (X) at height caster_radius to touch ground -->
      <origin xyz="${x_offset} 0.0 ${caster_radius}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_caster_link">
      <!-- Caster rolling sphere -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="caster_metallic"/>
      </visual>

      <!-- Caster mounting collar connecting to chassis underside -->
      <visual>
        <origin xyz="0 0 ${caster_radius * 0.7}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${caster_radius * 0.75}" length="${caster_radius * 0.6}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>

      <!-- Solid sphere inertia tensor -->
      <inertial>
        <mass value="${caster_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(2.0 / 5.0) * caster_mass * caster_radius * caster_radius}"
          ixy="0.0"
          ixz="0.0"
          iyy="${(2.0 / 5.0) * caster_mass * caster_radius * caster_radius}"
          iyz="0.0"
          izz="${(2.0 / 5.0) * caster_mass * caster_radius * caster_radius}"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>
